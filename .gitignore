# Per-device stock flash dumps: 16 MB each, and they carry this unit's serial and radio calibration.
backup/

build/
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# Your settings: Wi-Fi password, location and crew names. Copy config.example.h.
firmware/main/config.h
# Settings files from before config.h existed.
firmware/main/secrets.h
firmware/main/crew_config.h

# clangd index
firmware/.cache/

# Python bytecode from the tools
__pycache__/
